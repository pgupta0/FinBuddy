{
  "rules_version": "1.0.0",
  "skill_version": "1.1.0",
  "description": "Deterministic checks implementing Sections 4-6 of governance/advice-boundary-skill.md. Every pattern is a case-insensitive JavaScript regular expression. A pattern with \"negatable\": true is ignored when a negation word (see negation) appears just before the match, so \"returns are not guaranteed\" does not count as a guarantee. Edits to this file require Governance-admin sign-off (skill Section 13).",

  "negation": {
    "pattern": "\\b(not|no|never|cannot|can't|cant|won't|don't|doesn't|isn't|aren't|without|nor|neither)\\b|n't\\b",
    "window_chars": 40
  },

  "output_rules": [
    {
      "id": "R1-should-act",
      "rubric": "Q1",
      "rule": "R-1",
      "severity": "red",
      "negatable": true,
      "description": "Action verb aimed at the user",
      "patterns": [
        "\\byou (should|must|ought to|need to|have to|had better)( definitely| probably| really)? (buy|sell|invest|switch|redeem|hold|exit|start|stop|increase|reduce|add|move|put|allocate|pick|choose|go with)\\b",
        "\\bi(?:'d| would)? (recommend|suggest|advise) (that )?(you )?(buy|buying|sell|selling|invest|investing|switch|switching|redeem|redeeming|go with|going with|pick|picking)\\b",
        "\\bmy (recommendation|suggestion|advice) (for you )?(is|would be) to\\b"
      ]
    },
    {
      "id": "R6-timing",
      "rubric": "Q1",
      "rule": "R-6",
      "severity": "red",
      "negatable": true,
      "description": "Market-timing nudge",
      "patterns": [
        "\\bnow is (a |the )?(good|great|right|perfect|bad) time to (buy|sell|invest|enter|exit)\\b",
        "\\b(wait for|buy) (a|the) dip\\b",
        "\\b(markets?|nifty|sensex|gold|prices?) (will|is going to|are going to) (fall|rise|crash|go up|go down|rally|correct)\\b"
      ]
    },
    {
      "id": "R2-preference",
      "rubric": "Q2",
      "rule": "R-2",
      "severity": "red",
      "negatable": true,
      "description": "Named product in a preference context",
      "patterns": [
        "\\b(go with|opt for|stick with|you could pick|you can pick|i(?:'d| would) pick|i(?:'d| would) choose)\\b[^.\\n]{0,60}\\b(fund|scheme|etf|amc|plan)\\b",
        "\\b(is|are|looks like|seems like) (a |an |the )?(very |really )?(good|great|excellent|solid|better|best|ideal|right|smart|top) (choice|pick|option|bet|fit|fund|scheme|investment)( for you)?\\b",
        "\\b(is|are) better than\\b[^.\\n]{0,60}\\b(fund|scheme|flexi[- ]?cap|large[- ]?cap|mid[- ]?cap|small[- ]?cap|etf)\\b"
      ]
    },
    {
      "id": "R3-guarantee",
      "rubric": "Q3",
      "rule": "R-3",
      "severity": "red",
      "negatable": true,
      "description": "Return promise, prediction or safety claim",
      "patterns": [
        "\\b(guaranteed|assured|sure[- ]shot|risk[- ]free|zero[- ]risk|no[- ]risk) (returns?|income|profit|gains?|investment)\\b",
        "\\b(is|are) (completely |totally |very |100% |absolutely )?(safe|guaranteed|risk[- ]free)\\b",
        "\\bsafe (investment|bet|option|fund|choice)\\b",
        "\\bwill (give|deliver|return|earn|generate|double|grow)\\b[^.\\n]{0,40}(\\d+(\\.\\d+)?\\s?%|percent|returns?)",
        "\\b(likely|expected|set) to (give|deliver|return|earn|generate|grow)\\b[^.\\n]{0,30}\\d+(\\.\\d+)?\\s?%"
      ]
    },
    {
      "id": "R5-ranking",
      "rubric": "Q4",
      "rule": "R-5",
      "severity": "red",
      "negatable": true,
      "description": "Best list, ranking, rating or price target",
      "patterns": [
        "\\btop \\d+ (funds?|sips?|schemes?|stocks?|mutual funds?|etfs?)\\b",
        "\\b(the )?best (funds?|sips?|schemes?|stocks?|mutual funds?|etfs?|large[- ]?cap|mid[- ]?cap|small[- ]?cap|flexi[- ]?cap)( funds?)?( (to|for) (buy|invest|you|2\\d{3}))\\b",
        "\\b(price target|target price|stop[- ]loss (at|of|level)|entry price (of|at))\\b",
        "\\b(rated|rating of) \\d(\\.\\d)? ?(stars?|/ ?5)\\b",
        "\\bour (top|#1) pick\\b"
      ]
    },
    {
      "id": "R4-profiling",
      "rubric": "Q5",
      "rule": "R-4",
      "severity": "red",
      "negatable": true,
      "quiz_exception": true,
      "description": "Assesses the user's risk tolerance or suitability",
      "patterns": [
        "\\byou(?:'re| are) (an? )?(aggressive|conservative|moderate|cautious|high[- ]risk|low[- ]risk|risk[- ]averse|risk[- ]seeking)( investor)?\\b",
        "\\byour risk (profile|appetite|tolerance) (is|seems|looks)\\b",
        "\\bas an? (aggressive|conservative|moderate|young) investor,? you\\b",
        "\\b(since|because|as) you(?:'re| are) (young|aggressive|\\d{2})[^.\\n]{0,40}\\b(you|your)\\b",
        "\\bsuitable for you\\b"
      ]
    },
    {
      "id": "R1-reallocate",
      "rubric": "Q6",
      "rule": "R-1",
      "severity": "red",
      "negatable": true,
      "quiz_exception": true,
      "description": "Tells the user how to change their allocation",
      "patterns": [
        "\\b(move|shift|reallocate|transfer|put|allocate|switch)\\b[^.\\n]{0,25}\\d+\\s?%[^.\\n]{0,25}\\b(to|into|in)\\b[^.\\n]{0,15}\\b(equity|debt|gold|fds?|fixed deposits?|bonds?|stocks?|funds?|cash)\\b",
        "\\brebalance (your portfolio )?to\\b",
        "\\byour (portfolio|allocation) should\\b",
        "\\byou (should|could|can|might want to|may want to) (consider )?(add|adding|increase|increasing|reduce|reducing|cut|cutting|trim|trimming)\\b[^.\\n]{0,30}\\b(equity|debt|gold|fds?|exposure|allocation|stake)\\b"
      ]
    },
    {
      "id": "R8-recent-data",
      "rubric": "Q7",
      "rule": "R-8",
      "severity": "amber",
      "negatable": false,
      "description": "Recent market price, NAV or return data",
      "patterns": [
        "\\b(today|yesterday|this week|last week|this month|last month|past week|past few days)\\b[^.\\n]{0,60}\\b(nav|returns?|returned|closed|gained|fell|rose|up|down)\\b[^.\\n]{0,20}\\d",
        "\\b(nav|price) (is|was|stands at|closed at) (₹|rs\\.?|inr)\\s?\\d"
      ]
    },
    {
      "id": "R10-gap-language",
      "rubric": "Q8",
      "rule": "R-10",
      "severity": "amber",
      "negatable": true,
      "quiz_exception": true,
      "description": "Framework comparison implies a gap to close",
      "patterns": [
        "\\byour (described |current )?(allocation|portfolio|savings)\\b[^.\\n]{0,80}\\b(gap|shortfall|falls short|is missing|lacks|underweight|overweight|too (much|little|heavy|light))\\b",
        "\\b(ideal|optimal|correct|right) (allocation|mix|split|portfolio)( for you)?\\b",
        "\\b(close|fix|address) (the|this|that) gap\\b"
      ]
    },
    {
      "id": "R9-personal-tax",
      "rubric": "Q10",
      "rule": "R-9",
      "severity": "amber",
      "negatable": true,
      "description": "Tax, legal or insurance specifics for the user",
      "patterns": [
        "\\byou(?:'ll| will) (pay|owe|save)\\b[^.\\n]{0,40}\\b(tax|ltcg|stcg|cess)\\b",
        "\\byour (tax|tax liability|tax outgo) (will be|is|comes to)\\b"
      ]
    }
  ],

  "grounding": {
    "rubric": "Q9",
    "rule": "R-7",
    "severity": "amber",
    "description": "Fund facts stated without a citation",
    "fact_signal": "\\b(fund|scheme|portfolio|holdings?|aum|expense ratio|nav|amc)\\b[^.\\n]{0,80}\\d+(\\.\\d+)?\\s?%|\\d+(\\.\\d+)?\\s?%[^.\\n]{0,80}\\b(fund|scheme|holdings?|aum|expense ratio|nav|amc)\\b",
    "citation": "\\[\\[\\d+\\]\\]\\([^)]+\\)|\\]\\((https?:|kb:)"
  },

  "disclaimer": {
    "rubric": "Q11",
    "rule": "R-11",
    "severity": "amber",
    "description": "Disclaimer missing from a substantive answer",
    "present_patterns": [
      "not investment advice",
      "educational information only",
      "general financial education",
      "not a sebi[- ]registered"
    ],
    "substantive_min_chars": 280,
    "substantive_signal": "\\b(fund|scheme|invest|portfolio|allocation|sip|equity|debt|returns?|nav|market|stock|bond|etf|amc|risk)\\b"
  },

  "input_rules": [
    {
      "id": "I-1",
      "flag": "advice_request",
      "description": "Advice, ranking, prediction, timing or suitability request",
      "patterns": [
        "\\bwhich (\\w+ ){0,3}(fund|stock|sip|scheme|etf|share|mutual fund|amc)s?\\b[^?\\n]{0,40}\\b(should|to|do|would|will)\\b",
        "\\bshould i (buy|sell|invest|switch|redeem|hold|exit|start|stop|continue|move|keep|put|choose|pick)\\b",
        "\\bwhere (should|do|can|to) (i )?invest\\b",
        "\\bwhere should i put\\b",
        "(^|[.!?]\\s+)is (\\w+ ){1,5}(a )?(good|safe|bad|better|worth it|right|risky)\\b",
        "\\b(best|top \\d+|top) (\\w+ ){0,2}(funds?|sips?|stocks?|schemes?|mutual funds?|etfs?)\\b",
        "\\bwill (give|return|earn)( me)? \\d+",
        "\\b(is|are) (now|today|this) (a )?(good|right|bad) time\\b",
        "\\bgood time to (invest|buy|sell)\\b",
        "\\b(my )?ideal allocation\\b",
        "\\b(better|vs\\.?|versus)\\b[^?\\n]{0,40}\\b(flexi|large|mid|small|multi)[- ]?cap\\b",
        "\\bif you (had to|must|have to) (choose|pick|recommend)\\b",
        "\\brecommend (me |a |some |one |any )?(\\w+ )?(funds?|stocks?|sips?|schemes?)\\b",
        "\\btell me what to (buy|sell|invest)\\b",
        "\\bhelp me pick\\b"
      ]
    },
    {
      "id": "I-5",
      "flag": "bypass_attempt",
      "description": "Injection or jailbreak attempt",
      "patterns": [
        "\\bignore (all |any |your |the |previous |prior |above )*(instructions|rules|guidelines|restrictions|prompt)\\b",
        "(^|\\n)\\s*\\[?(system|developer|admin)\\]?\\s*:",
        "\\bcompliance (mode )?(off|disabled)\\b",
        "\\bpretend (you(?:'re| are)|to be)\\b",
        "\\b(act|behave|respond) as (if you (are|were) )?(my |an? )?(sebi|registered|financial adviser|advisor|dan)\\b",
        "\\b(developer|god|jailbreak|unrestricted) mode\\b",
        "\\bhypothetically\\b[^?\\n]{0,80}\\b(fund|stock|invest|buy|choose|pick)\\b",
        "\\bjust for fun\\b[^?\\n]{0,60}\\b(fund|stock|invest|buy|pick)\\b"
      ]
    },
    {
      "id": "I-1b",
      "flag": "indirect_advice_request",
      "also_flags": ["advice_request"],
      "description": "Advice sought on behalf of someone else",
      "patterns": [
        "\\bmy (friend|brother|sister|mom|mother|dad|father|parent|colleague|cousin|wife|husband)\\b[^?\\n]{0,40}\\b(wants|asked|asks|needs) to know\\b"
      ]
    },
    {
      "id": "I-3",
      "flag": "financial_details",
      "description": "User shared income, savings or holdings figures",
      "patterns": [
        "(₹|\\brs\\.?\\s?|\\binr\\s?)\\s?\\d",
        "\\b\\d+(\\.\\d+)?\\s?(lakh|lakhs|lac|crore|cr|k)\\b",
        "\\bmy (savings|salary|income|portfolio|holdings|investments)\\b[^.\\n]{0,40}\\d",
        "\\b\\d{1,3}\\s?%\\s?(in |into )?(fds?|fixed deposits?|equity|debt|gold|stocks?|mutual funds?|cash|bonds?|ppf|epf)\\b"
      ]
    },
    {
      "id": "I-4",
      "flag": "vulnerable_user",
      "review_reason": "vulnerable_user",
      "description": "Distress, vulnerability or minor",
      "patterns": [
        "\\blost (all|everything|most|my (entire |whole )?(savings|money|life savings))\\b",
        "\\b(win|make|get) (it|my money|that) back( fast| quickly)?\\b",
        "\\b(drowning in|can't pay|cannot pay|unable to repay|loan sharks?|debt trap)\\b",
        "\\b(panic|panicking)\\b[^.\\n]{0,30}\\b(sell|selling|sold|market|crash)\\b",
        "\\b(suicid|kill myself|end my life|no way out)",
        "\\b(gambl|betting|f&o to recover|double my money fast)",
        "\\bi(?:'m| am) (1[0-7]|[5-9])( years? old| yo|\\b)",
        "\\bi(?:'m| am) (still )?in (class|grade|standard|std) ?\\d",
        "\\b(i(?:'m| am) a minor|under ?18|not 18 yet)\\b"
      ]
    },
    {
      "id": "I-6",
      "flag": "grievance",
      "review_reason": "grievance",
      "description": "Complaint or data-rights request",
      "patterns": [
        "\\b(complain|complaint|grievance)\\b",
        "\\b(delete|erase|remove|correct|access|export|download) (all )?(of )?my (data|information|details|history|chats?)\\b",
        "\\bwithdraw (my )?consent\\b"
      ]
    },
    {
      "id": "I-7",
      "flag": "regulatory_question",
      "review_reason": "regulatory_question",
      "description": "Asks whether something is legal or compliant",
      "patterns": [
        "\\bis (finbuddy|this (app|bot|tool|service)|it|this) (legal|compliant|allowed|permitted|lawful)\\b",
        "\\b(legal|compliant|allowed|permitted) under (sebi|rbi|the law|dpdp)\\b"
      ]
    },
    {
      "id": "I-8",
      "flag": "tax_legal_question",
      "outside_authority": "chartered accountant / tax professional",
      "description": "Tax, legal or insurance question",
      "patterns": [
        "\\b(i|my|me|i'll|i'm)\\b[^?\\n]{0,60}\\b(tax|taxes|taxed|ltcg|stcg|itr|80c|tds|capital gains?)\\b",
        "\\b(tax|taxes|taxed|ltcg|stcg|itr|80c|tds|capital gains?)\\b[^?\\n]{0,60}\\b(i|my|me)\\b"
      ]
    },
    {
      "id": "I-9",
      "flag": "recent_data_request",
      "description": "Asks for recent market data",
      "patterns": [
        "\\b(today|yesterday|this week|last week|this month|last month|right now|currently)\\b[^?\\n]{0,40}\\b(nifty|sensex|nav|returns?|price|market)\\b",
        "\\b(nifty|sensex|nav|returns?|price)\\b[^?\\n]{0,40}\\b(today|yesterday|this week|last week|this month|last month|right now)\\b"
      ]
    }
  ],

  "pii": [
    { "type": "email", "pattern": "\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b" },
    { "type": "pan", "pattern": "\\b[A-Z]{5}[0-9]{4}[A-Z]\\b" },
    { "type": "aadhaar", "pattern": "\\b[2-9][0-9]{3}[\\s-]?[0-9]{4}[\\s-]?[0-9]{4}\\b" },
    { "type": "ifsc", "pattern": "\\b[A-Z]{4}0[A-Z0-9]{6}\\b" },
    { "type": "demat_account", "pattern": "\\b(IN[0-9]{14}|[0-9]{16})\\b" },
    { "type": "phone", "pattern": "(\\+91[\\s-]?|\\b0)?\\b[6-9][0-9]{4}[\\s-]?[0-9]{5}\\b" },
    { "type": "date_of_birth", "pattern": "\\b(dob|d\\.o\\.b\\.?|date of birth|born on)\\s*[:\\-]?\\s*[0-9]{1,2}[/.\\-][0-9]{1,2}[/.\\-][0-9]{2,4}\\b" },
    { "type": "account_or_folio_number", "pattern": "\\b(account|a/c|acct|folio|demat|client id|bo id)\\s*(no\\.?|number|#)?\\s*(is|:)?\\s*(?=[A-Z0-9/\\-]*[0-9])[A-Z0-9/\\-]{6,20}\\b" }
  ],

  "session": {
    "repeated_advice_threshold": 3
  }
}
